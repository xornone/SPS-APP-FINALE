# Supabase — Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# Service role key — SERVEUR UNIQUEMENT, ne jamais exposer au client.
# Utilisee par les routes /api/admin/* (invitation/suppression de membres, upload GPX).
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# URL publique de l'app (utilisee pour le lien de redirection du magic link)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
